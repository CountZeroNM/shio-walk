{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        ring/ring-core {:mvn/version "1.12.1"}
        ring/ring-jetty-adapter {:mvn/version "1.12.1"}
        ring/ring-json {:mvn/version "0.5.1"}
        compojure/compojure {:mvn/version "1.7.1"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.909"}
        org.postgresql/postgresql {:mvn/version "42.7.1"}
        com.zaxxer/HikariCP {:mvn/version "5.1.0"}
        buddy/buddy-hashers {:mvn/version "2.0.167"}
        buddy/buddy-sign {:mvn/version "3.5.351"}
        ring-cors/ring-cors {:mvn/version "0.1.13"}}
 
 :aliases {:run {:main-opts ["-m" "shio-walk.core"]}
           ;; 開発用: ウォーク・統計・獲得報酬を消す
           :reset {:main-opts ["-m" "shio-walk.reset"]}
           ;; API のテスト。DB_NAME=shio_walk_test のような別の DB で動かす (scripts/test-backend.sh)
           :test {:extra-paths ["test"]
                  :extra-deps {ring/ring-mock {:mvn/version "0.4.0"}
                               io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]}
           :migrate {:extra-paths ["resources"]
                    :extra-deps {migratus/migratus {:mvn/version "1.5.0"}
                                com.github.seancorfield/next.jdbc {:mvn/version "1.3.909"}
                                org.postgresql/postgresql {:mvn/version "42.7.1"}}
                    :main-opts ["-m" "shio-walk.migrate"]}}}
